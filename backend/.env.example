# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String
# For local MongoDB: mongodb://127.0.0.1:27017/task_dashboard
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/task_dashboard?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/task_dashboard

# Allowed CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5500,http://localhost:9000
